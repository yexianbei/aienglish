{
  "name": "AI English Learning",
  "description": "智能英语学习助手 - 在聊天中收集生词，通过艾宾浩斯记忆曲线高效复习",
  "version": "1.0.0",
  "developer": {
    "name": "Your Name",
    "url": "https://aienglish-frontend.vercel.app",
    "email": "yzdsoft@gmail.com"
  },
  "logo": {
    "url": "https://aienglish-frontend.vercel.app/logo.png",
    "alt": "AI English Logo"
  },
  "permissions": [
    "context.read",
    "user.read"
  ],
  "entry_point": {
  "type": "iframe",
  "url": "https://aienglish-frontend.vercel.app/chatgpt-app"
  },
  "triggers": [
  {
    "type": "button",
    "text": "📝 加入生词本",
    "description": "将翻译的单词或短语添加到生词本",
    "placement": ["message_actions"]
  },
  {
    "type": "button",
    "text": "📖 查看我的生词本",
    "description": "在 ChatGPT 中打开一个页面，查看当前账号下的生词本列表",
    "placement": ["app_actions"],
    "parameters": {
      "mode": "wordbook"
    }
  }
  ],
  "capabilities": [
    "translation",
    "vocabulary_tracking",
    "spaced_repetition"
  ],
  "privacy_policy": "https://aienglish-frontend.vercel.app/privacy",
  "terms_of_service": "https://aienglish-frontend.vercel.app/terms"
}

